import cv2
import numpy as np
import torch
from ultralytics import YOLO
from collections import defaultdict, deque
import time
from threading import Thread, Lock
import matplotlib.pyplot as plt
from matplotlib.backends.backend_agg import FigureCanvasAgg as FigureCanvas
from scipy.optimize import linear_sum_assignment
import warnings
from google.colab.patches import cv2_imshow
warnings.filterwarnings('ignore')

class MultiModalDetector:
    def __init__(self, rgb_model_path='yolov8x.pt', thermal_model_path=None,
                 device='cuda' if torch.cuda.is_available() else 'cpu'):
        """
        Initialize multi-modal detector with RGB and Thermal models
        """
        print(f"Initializing Multi-Modal Detector on {device}...")

        # Load RGB model
        self.rgb_model = YOLO(rgb_model_path)
        self.rgb_model.to(device)

        # Load or adapt thermal model
        if thermal_model_path:
            self.thermal_model = YOLO(thermal_model_path)
        else:
            # Use same model for thermal with adjusted confidence
            self.thermal_model = YOLO(rgb_model_path)

        self.thermal_model.to(device)

        # Fusion parameters
        self.rgb_weight = 0.6
        self.thermal_weight = 0.4
        self.iou_threshold = 0.5
        self.confidence_threshold = 0.3

        # Tracking state
        self.track_history = defaultdict(lambda: deque(maxlen=50))
        self.object_id_counter = 0
        self.tracked_objects = {}

        # Performance metrics
        self.metrics = {
            'rgb_fps': deque(maxlen=100),
            'thermal_fps': deque(maxlen=100),
            'fusion_fps': deque(maxlen=100),
            'detection_counts': deque(maxlen=100),
            'fusion_latency': deque(maxlen=100)
        }

        # Lock for thread-safe operations
        self.lock = Lock()

        print("Multi-Modal Detector initialized successfully")

    def preprocess_thermal(self, thermal_frame):
        """
        Enhanced thermal preprocessing with adaptive contrast enhancement
        """
        if len(thermal_frame.shape) == 2:
            thermal_frame = cv2.cvtColor(thermal_frame, cv2.COLOR_GRAY2BGR)

        # Apply CLAHE for better contrast
        lab = cv2.cvtColor(thermal_frame, cv2.COLOR_BGR2LAB)
        l, a, b = cv2.split(lab)
        clahe = cv2.createCLAHE(clipLimit=3.0, tileGridSize=(8,8))
        l = clahe.apply(l)
        enhanced = cv2.merge([l, a, b])
        enhanced = cv2.cvtColor(enhanced, cv2.COLOR_LAB2BGR)

        # Apply thermal-specific color mapping
        thermal_colormap = cv2.applyColorMap(
            cv2.cvtColor(enhanced, cv2.COLOR_BGR2GRAY),
            cv2.COLORMAP_JET
        )

        return thermal_colormap

    def detect_rgb(self, frame):
        """
        Detect objects in RGB frame with optimized inference
        """
        results = self.rgb_model(frame, conf=self.confidence_threshold,
                                verbose=False)[0]
        return self._process_results(results, 'rgb')

    def detect_thermal(self, frame):
        """
        Detect objects in thermal frame
        """
        processed_frame = self.preprocess_thermal(frame)
        results = self.thermal_model(processed_frame,
                                    conf=self.confidence_threshold * 0.8,  # Lower threshold for thermal
                                    verbose=False)[0]
        return self._process_results(results, 'thermal')

    def _process_results(self, results, modality):
        """
        Extract standardized detection results
        """
        detections = []

        if results.boxes is not None:
            boxes = results.boxes.xyxy.cpu().numpy()
            confidences = results.boxes.conf.cpu().numpy()
            class_ids = results.boxes.cls.cpu().numpy()

            for box, conf, cls_id in zip(boxes, confidences, class_ids):
                detections.append({
                    'bbox': box.astype(int),
                    'confidence': float(conf),
                    'class_id': int(cls_id),
                    'class_name': results.names[int(cls_id)],
                    'modality': modality
                })

        return detections

    def adaptive_fusion(self, rgb_detections, thermal_detections):
        """
        Advanced fusion strategy with adaptive weighting
        """
        if not rgb_detections and not thermal_detections:
            return [], {}

        all_detections = rgb_detections + thermal_detections

        # Calculate fusion metrics
        fusion_metrics = {
            'rgb_only': len(rgb_detections) - len(self._find_overlapping(rgb_detections, thermal_detections)),
            'thermal_only': len(thermal_detections) - len(self._find_overlapping(thermal_detections, rgb_detections)),
            'matched': len(self._find_overlapping(rgb_detections, thermal_detections))
        }

        # Adaptive weighting based on confidence distribution
        if rgb_detections and thermal_detections:
            avg_rgb_conf = np.mean([d['confidence'] for d in rgb_detections])
            avg_thermal_conf = np.mean([d['confidence'] for d in thermal_detections])

            # Adjust weights based on modality confidence
            total_conf = avg_rgb_conf + avg_thermal_conf
            if total_conf > 0:
                self.rgb_weight = avg_rgb_conf / total_conf
                self.thermal_weight = avg_thermal_conf / total_conf

        # Match and fuse detections
        fused_detections = []
        matched_indices = set()

        for i, rgb_det in enumerate(rgb_detections):
            for j, thermal_det in enumerate(thermal_detections):
                if j in matched_indices:
                    continue

                iou = self._calculate_iou(rgb_det['bbox'], thermal_det['bbox'])

                if iou > self.iou_threshold:
                    # Weighted fusion
                    fused_conf = (self.rgb_weight * rgb_det['confidence'] +
                                 self.thermal_weight * thermal_det['confidence'])

                    # Average bounding box
                    fused_bbox = np.mean([rgb_det['bbox'], thermal_det['bbox']], axis=0).astype(int)

                    fused_detections.append({
                        'bbox': fused_bbox,
                        'confidence': fused_conf,
                        'class_id': rgb_det['class_id'],
                        'class_name': rgb_det['class_name'],
                        'rgb_conf': rgb_det['confidence'],
                        'thermal_conf': thermal_det['confidence'],
                        'modality': 'fused'
                    })

                    matched_indices.add(j)
                    break
            else:
                # Unmatched RGB detection
                fused_detections.append({
                    'bbox': rgb_det['bbox'],
                    'confidence': rgb_det['confidence'] * 0.9,  # Slight penalty for single modality
                    'class_id': rgb_det['class_id'],
                    'class_name': rgb_det['class_name'],
                    'rgb_conf': rgb_det['confidence'],
                    'thermal_conf': 0,
                    'modality': 'rgb_only'
                })

        # Add unmatched thermal detections
        for j, thermal_det in enumerate(thermal_detections):
            if j not in matched_indices:
                fused_detections.append({
                    'bbox': thermal_det['bbox'],
                    'confidence': thermal_det['confidence'] * 0.7,  # Higher penalty for thermal only
                    'class_id': thermal_det['class_id'],
                    'class_name': thermal_det['class_name'],
                    'rgb_conf': 0,
                    'thermal_conf': thermal_det['confidence'],
                    'modality': 'thermal_only'
                })

        return fused_detections, fusion_metrics

    def _calculate_iou(self, box1, box2):
        """
        Calculate Intersection over Union
        """
        x1 = max(box1[0], box2[0])
        y1 = max(box1[1], box2[1])
        x2 = min(box1[2], box2[2])
        y2 = min(box1[3], box2[3])

        intersection = max(0, x2 - x1) * max(0, y2 - y1)

        area1 = (box1[2] - box1[0]) * (box1[3] - box1[1])
        area2 = (box2[2] - box2[0]) * (box2[3] - box2[1])

        union = area1 + area2 - intersection

        return intersection / union if union > 0 else 0

    def _find_overlapping(self, detections1, detections2):
        """
        Find overlapping detections between two sets
        """
        overlapping = []
        for det1 in detections1:
            for det2 in detections2:
                if self._calculate_iou(det1['bbox'], det2['bbox']) > self.iou_threshold:
                    overlapping.append(det1)
                    break
        return overlapping

    def update_tracking(self, detections):
        """
        Update object tracking with temporal consistency
        """
        current_objects = {}

        # Match detections to existing tracks using Hungarian algorithm
        if self.tracked_objects and detections:
            tracked_ids = list(self.tracked_objects.keys())
            cost_matrix = np.zeros((len(tracked_ids), len(detections)))

            for i, track_id in enumerate(tracked_ids):
                track_bbox = self.tracked_objects[track_id]['bbox']
                for j, det in enumerate(detections):
                    cost_matrix[i, j] = 1 - self._calculate_iou(track_bbox, det['bbox'])

            # Apply Hungarian algorithm for optimal assignment
            row_ind, col_ind = linear_sum_assignment(cost_matrix)

            matched_tracks = set()
            matched_detections = set()

            for track_idx, det_idx in zip(row_ind, col_ind):
                if cost_matrix[track_idx, det_idx] < 0.5:  # IOU > 0.5
                    track_id = tracked_ids[track_idx]
                    detection = detections[det_idx]

                    # Smooth bounding box with exponential moving average
                    alpha = 0.3
                    smoothed_bbox = (alpha * detection['bbox'] +
                                    (1 - alpha) * self.tracked_objects[track_id]['bbox'])

                    current_objects[track_id] = {
                        'bbox': smoothed_bbox.astype(int),
                        'class_name': detection['class_name'],
                        'confidence': detection['confidence'],
                        'age': self.tracked_objects[track_id]['age'] + 1,
                        'modality': detection['modality']
                    }

                    matched_tracks.add(track_id)
                    matched_detections.add(det_idx)

            # Remove unmatched tracks
            for track_id in tracked_ids:
                if track_id not in matched_tracks:
                    self.tracked_objects[track_id]['age'] = -1  # Mark for removal

            # Add new detections
            for i, det in enumerate(detections):
                if i not in matched_detections:
                    self.object_id_counter += 1
                    new_id = self.object_id_counter
                    current_objects[new_id] = {
                        'bbox': det['bbox'],
                        'class_name': det['class_name'],
                        'confidence': det['confidence'],
                        'age': 1,
                        'modality': det['modality']
                    }
        else:
            # Initialize tracks
            for det in detections:
                self.object_id_counter += 1
                new_id = self.object_id_counter
                current_objects[new_id] = {
                    'bbox': det['bbox'],
                    'class_name': det['class_name'],
                    'confidence': det['confidence'],
                    'age': 1,
                    'modality': det['modality']
                }

        # Clean up old tracks
        self.tracked_objects = {k: v for k, v in current_objects.items() if v['age'] > -1}

        return current_objects

    def create_performance_graphs(self):
        """
        Create real-time performance visualization graphs
        """
        fig, axes = plt.subplots(2, 3, figsize=(15, 8))
        fig.suptitle('Multi-Modal Surveillance System Performance', fontsize=14, fontweight='bold')

        # FPS Graph
        ax1 = axes[0, 0]
        if len(self.metrics['rgb_fps']) > 0:
            ax1.plot(list(self.metrics['rgb_fps']), label='RGB FPS', alpha=0.7)
            ax1.plot(list(self.metrics['thermal_fps']), label='Thermal FPS', alpha=0.7)
            ax1.plot(list(self.metrics['fusion_fps']), label='Fusion FPS', alpha=0.7)
        ax1.set_title('Processing FPS')
        ax1.set_xlabel('Frame')
        ax1.set_ylabel('FPS')
        ax1.legend()
        ax1.grid(True, alpha=0.3)

        # Detection Counts
        ax2 = axes[0, 1]
        if len(self.metrics['detection_counts']) > 0:
            counts = list(self.metrics['detection_counts'])
            ax2.bar(range(len(counts)), counts, alpha=0.7)
        ax2.set_title('Objects Detected per Frame')
        ax2.set_xlabel('Frame')
        ax2.set_ylabel('Count')
        ax2.grid(True, alpha=0.3)

        # Modality Confidence Distribution
        ax3 = axes[0, 2]
        modalities = ['RGB', 'Thermal', 'Fused']
        confidences = [self.rgb_weight, self.thermal_weight, 1.0]
        bars = ax3.bar(modalities, confidences, color=['blue', 'red', 'green'], alpha=0.7)
        ax3.set_title('Modality Weights')
        ax3.set_ylabel('Weight')
        ax3.set_ylim([0, 1])
        for bar, conf in zip(bars, confidences):
            height = bar.get_height()
            ax3.text(bar.get_x() + bar.get_width()/2., height,
                    f'{conf:.2f}', ha='center', va='bottom')

        # Latency Distribution
        ax4 = axes[1, 0]
        if len(self.metrics['fusion_latency']) > 0:
            ax4.hist(list(self.metrics['fusion_latency']), bins=20, alpha=0.7, edgecolor='black')
        ax4.set_title('Fusion Latency Distribution')
        ax4.set_xlabel('Latency (ms)')
        ax4.set_ylabel('Frequency')
        ax4.grid(True, alpha=0.3)

        # Detection Heat Map (confidence over time)
        ax5 = axes[1, 1]
        ax5.text(0.5, 0.5, 'Detection Confidence\nHeat Map',
                ha='center', va='center', transform=ax5.transAxes)
        ax5.set_title('Confidence Heat Map')

        # System Status
        ax6 = axes[1, 2]
        ax6.axis('off')
        status_text = f"""
        System Status:
        • RGB Model: yolov8x
        • Thermal Model: yolov8
        • Device: {'CUDA' if torch.cuda.is_available() else 'CPU'}
        • Avg FPS: {np.mean(self.metrics['fusion_fps']):.1f}
        • Active Tracks: {len(self.tracked_objects)}
        • Fusion Strategy: Adaptive
        """
        ax6.text(0.1, 0.5, status_text, fontsize=10, family='monospace',
                verticalalignment='center')

        plt.tight_layout()

        # Convert plot to image using buffer_rgba and then to BGR for OpenCV
        canvas = FigureCanvas(fig)
        canvas.draw()
        renderer = canvas.get_renderer()
        raw_data = renderer.buffer_rgba()
        graph_image = np.asarray(raw_data)
        graph_image = cv2.cvtColor(graph_image, cv2.COLOR_RGBA2BGR)

        plt.close(fig)

        return graph_image

    def draw_detections(self, frame, tracked_objects, fusion_metrics=None):
        """
        Draw detection boxes and tracking information with enhanced visualization
        """
        display_frame = frame.copy()

        # Create semi-transparent overlay for detections
        overlay = display_frame.copy()

        for track_id, obj in tracked_objects.items():
            bbox = obj['bbox']
            class_name = obj['class_name']
            confidence = obj['confidence']
            modality = obj['modality']

            # Color coding based on modality
            if modality == 'fused':
                color = (0, 255, 0)  # Green for fused detections
                thickness = 3
            elif modality == 'rgb_only':
                color = (255, 0, 0)  # Blue for RGB only
                thickness = 2
            else:  # thermal_only
                color = (0, 0, 255)  # Red for thermal only
                thickness = 2

            # Draw bounding box
            cv2.rectangle(overlay, (bbox[0], bbox[1]), (bbox[2], bbox[3]), color, thickness)

            # Draw tracking ID and info
            label = f"ID:{track_id} {class_name} {confidence:.2f}"

            # Background for text
            (label_w, label_h), _ = cv2.getTextSize(label, cv2.FONT_HERSHEY_SIMPLEX, 0.6, 2)
            cv2.rectangle(overlay, (bbox[0], bbox[1] - label_h - 10),
                         (bbox[0] + label_w, bbox[1]), color, -1)

            # Text
            cv2.putText(overlay, label, (bbox[0], bbox[1] - 5),
                       cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 255, 255), 2)

            # Draw trail for tracked objects
            if track_id in self.track_history:
                points = list(self.track_history[track_id])
                if len(points) > 1:
                    for i in range(1, len(points)):
                        cv2.line(overlay, points[i-1], points[i], color, 2)

            # Update track history
            center = ((bbox[0] + bbox[2]) // 2, (bbox[1] + bbox[3]) // 2)
            self.track_history[track_id].append(center)

        # Apply overlay with transparency
        alpha = 0.4
        display_frame = cv2.addWeighted(overlay, alpha, display_frame, 1 - alpha, 0)

        # Draw fusion metrics
        if fusion_metrics:
            y_offset = 30
            metrics_text = [
                f"Fused: {fusion_metrics.get('matched', 0)}",
                f"RGB Only: {fusion_metrics.get('rgb_only', 0)}",
                f"Thermal Only: {fusion_metrics.get('thermal_only', 0)}"
            ]

            for i, text in enumerate(metrics_text):
                cv2.putText(display_frame, text, (10, y_offset + i * 30),
                           cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 255, 255), 2)

        return display_frame

    def run_surveillance(self, rgb_source, thermal_source, output_path='surveillance_output.mp4',
                        display=True, save_output=True):
        """
        Main surveillance processing loop
        """
        # Open video captures
        rgb_cap = cv2.VideoCapture(rgb_source)
        thermal_cap = cv2.VideoCapture(thermal_source)

        # Check if video sources are opened successfully
        if not rgb_cap.isOpened():
            print(f"Error: Could not open RGB video source: {rgb_source}")
            return
        if not thermal_cap.isOpened():
            print(f"Error: Could not open Thermal video source: {thermal_source}")
            return
        print(f"Successfully opened RGB video: {rgb_source}")
        print(f"Successfully opened Thermal video: {thermal_source}")

        # Get video properties
        width = int(rgb_cap.get(cv2.CAP_PROP_FRAME_WIDTH))
        height = int(rgb_cap.get(cv2.CAP_PROP_FRAME_HEIGHT))
        fps = int(rgb_cap.get(cv2.CAP_PROP_FPS))

        # Initialize video writer
        if save_output:
            # Use a more compatible codec like XVID for .avi
            fourcc_out = cv2.VideoWriter_fourcc(*'XVID')
            # Change output path extension to .avi
            output_path_avi = output_path.replace('.mp4', '.avi')
            out = cv2.VideoWriter(output_path_avi, fourcc_out, fps, (width * 2, height * 2))
            if not out.isOpened():
                print(f"Error: Could not open video writer for output: {output_path_avi}")
                save_output = False # Disable saving if writer fails
            else:
                print(f"Successfully opened video writer for output: {output_path_avi}")

        print(f"Starting Multi-Modal Surveillance System")
        print(f"Output: {output_path_avi if save_output else 'Not saving output'}")
        print(f"Resolution: {width}x{height} @ {fps}fps")

        frame_count = 0
        start_time = time.time()

        while True:
            frame_start = time.time()

            # Read frames
            ret_rgb, rgb_frame = rgb_cap.read()
            ret_thermal, thermal_frame = thermal_cap.read()

            if not ret_rgb or not ret_thermal:
                break

            # Process frames
            rgb_detections = self.detect_rgb(rgb_frame)
            thermal_detections = self.detect_thermal(thermal_frame)

            # Fusion
            fusion_start = time.time()
            fused_detections, fusion_metrics = self.adaptive_fusion(rgb_detections, thermal_detections)
            fusion_time = (time.time() - fusion_start) * 1000  # ms

            # Update tracking
            tracked_objects = self.update_tracking(fused_detections)

            # Update metrics
            with self.lock:
                self.metrics['fusion_latency'].append(fusion_time)
                self.metrics['detection_counts'].append(len(tracked_objects))

            # Draw results
            rgb_display = self.draw_detections(rgb_frame, tracked_objects, fusion_metrics)
            thermal_display = thermal_frame.copy()
            if len(thermal_display.shape) == 2:
                thermal_display = cv2.cvtColor(thermal_display, cv2.COLOR_GRAY2BGR)
            thermal_display = cv2.resize(thermal_display, (width, height))

            # Create performance graphs
            graphs = self.create_performance_graphs()

            # Combine displays
            top_row = np.hstack([rgb_display, thermal_display])

            # Resize graphs to match width
            graph_height = height
            graphs_resized = cv2.resize(graphs, (width * 2, graph_height))

            full_display = np.vstack([top_row, graphs_resized])

            # Calculate and display FPS
            frame_count += 1
            elapsed_time = time.time() - start_time
            current_fps = frame_count / elapsed_time if elapsed_time > 0 else 0

            cv2.putText(full_display, f"FPS: {current_fps:.1f}", (10, height * 2 - 20),
                       cv2.FONT_HERSHEY_SIMPLEX, 0.8, (0, 255, 0), 2)
            cv2.putText(full_display, f"Frame: {frame_count}", (10, height * 2 - 50),
                       cv2.FONT_HERSHEY_SIMPLEX, 0.8, (0, 255, 0), 2)

            # Save output
            if save_output and out.isOpened():
                out.write(full_display)

            # Display in Colab
            if display and frame_count % 30 == 0:
                cv2_imshow(full_display)

            # Performance monitoring
            if frame_count % 30 == 0:
                avg_fps = 30 / (time.time() - start_time + 1e-6)
                print(f"Frame {frame_count}: {len(tracked_objects)} objects tracked, "
                      f"FPS: {avg_fps:.1f}, Latency: {fusion_time:.1f}ms")
                start_time = time.time()

        # Cleanup
        rgb_cap.release()
        thermal_cap.release()
        if save_output and out.isOpened():
            out.release()
        cv2.destroyAllWindows()

        print(f"\n Surveillance completed: {frame_count} frames processed")
        self.generate_final_report(frame_count)

    def generate_final_report(self, total_frames):
        """
        Generate comprehensive final performance report
        """
        print("\n" + "="*50)
        print("FINAL PERFORMANCE REPORT")
        print("="*50)

        # Calculate statistics
        avg_fusion_fps = np.mean(self.metrics['fusion_fps']) if self.metrics['fusion_fps'] else 0
        avg_detections = np.mean(self.metrics['detection_counts']) if self.metrics['detection_counts'] else 0
        avg_latency = np.mean(self.metrics['fusion_latency']) if self.metrics['fusion_latency'] else 0

        print(f"Total Frames Processed: {total_frames}")
        print(f"Average FPS: {avg_fusion_fps:.2f}")
        print(f"Average Objects per Frame: {avg_detections:.1f}")
        print(f"Average Fusion Latency: {avg_latency:.2f} ms")
        print(f"Total Unique Objects Tracked: {self.object_id_counter}")
        print(f"Active Tracks at End: {len(self.tracked_objects)}")

        # Modality effectiveness
        print("\nDetection Source Distribution:")
        if self.tracked_objects:
            modalities = defaultdict(int)
            for obj in self.tracked_objects.values():
                modalities[obj['modality']] += 1

            total = sum(modalities.values())
            for mod, count in modalities.items():
                print(f"   {mod}: {count} ({count/total*100:.1f}%) affinities")

        print("\n" + "="*50)

