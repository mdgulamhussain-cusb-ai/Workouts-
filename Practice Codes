class DetectionLoss(nn.Module):
    def __init__(self, num_classes):
        super().__init__()
        self.num_classes = num_classes
    def forward(self, cls_p, reg_p, obj_p, boxes, labels):
        return torch.tensor(1.0, requires_grad=True, device=cls_p.device) # Dummy loss

class AverageMeter:
    def __init__(self): self.reset()
    def reset(self): self.val = self.avg = self.sum = self.count = 0
    def update(self, val, n=1):
        self.val = val; self.sum += val * n; self.count += n; self.avg = self.sum / self.count

def evaluate_map(model, loader, iou_threshold=0.5):
    return 0.0, [0.0]*cfg.NUM_CLASSES # Dummy eval

def train_one_epoch(model, loader, optimizer, criterion):
    model.train(); total_loss = AverageMeter()
    for batch in loader:
        rgb, th = batch['rgb'].to(DEVICE), batch['thermal'].to(DEVICE)
        optimizer.zero_grad()
        loss = criterion(*model(rgb, th), batch['boxes'], batch['labels'])
        loss.backward(); optimizer.step()
        total_loss.update(loss.item(), rgb.size(0))
    return total_loss.avg

def train_model(model, train_loader, val_loader, model_name, epochs=cfg.EPOCHS):
    optimizer = optim.AdamW(model.parameters(), lr=cfg.LR)
    # Removed 'verbose' argument to avoid TypeError in newer PyTorch versions
    scheduler = optim.lr_scheduler.ReduceLROnPlateau(optimizer, mode='max', factor=cfg.LR_FACTOR, patience=cfg.LR_PATIENCE)
    criterion = DetectionLoss(cfg.NUM_CLASSES)

    history = {'train_loss': [], 'val_mAP': [], 'val_mAP50_95': [], 'epoch_times': [], 'best_mAP': 0.0, 'best_epoch': 0}

    print(f"\nTraining {model_name}")
    for epoch in range(epochs):
        start = time.time()
        loss = train_one_epoch(model, train_loader, optimizer, criterion)
        mAP, _ = evaluate_map(model, val_loader)
        history['train_loss'].append(loss)
        history['val_mAP'].append(mAP)
        history['val_mAP50_95'].append(mAP * 0.7)
        history['epoch_times'].append(time.time() - start)
        scheduler.step(mAP)
        if mAP >= history['best_mAP']:
            history['best_mAP'] = mAP; history['best_epoch'] = epoch + 1
        print(f"Epoch {epoch+1}: Loss={loss:.4f}, mAP={mAP:.2f}%")
    return history

