class DepthwiseSeparableConv(nn.Module):
    def __init__(self, in_ch, out_ch, stride=1):
        super().__init__()
        self.dw = nn.Conv2d(in_ch, in_ch, 3, stride, 1, groups=in_ch, bias=False)
        self.pw = nn.Conv2d(in_ch, out_ch, 1, bias=False)
        self.bn = nn.BatchNorm2d(out_ch)
        self.act = nn.ReLU(inplace=True)
    def forward(self, x):
        return self.act(self.bn(self.pw(self.dw(x))))

class OriginalModel(nn.Module):
    def __init__(self, num_classes=15):
        super().__init__()
        self.backbone_rgb = nn.Sequential(nn.Conv2d(3, 16, 3, 2, 1), nn.ReLU(), nn.Conv2d(16, 32, 3, 2, 1))
        self.backbone_th = nn.Sequential(nn.Conv2d(1, 16, 3, 2, 1), nn.ReLU(), nn.Conv2d(16, 32, 3, 2, 1))
        self.fuse = nn.Conv2d(64, 32, 1)
        self.head = nn.Conv2d(32, num_classes + 5, 1)

    def forward(self, rgb, th):
        f_rgb = self.backbone_rgb(rgb)
        f_th = self.backbone_th(th)
        fused = torch.cat([f_rgb, f_th], dim=1)
        fused = self.fuse(fused)
        out = self.head(fused)
        B, C, H, W = out.shape
        out = out.reshape(B, -1, H*W).permute(0, 2, 1)
        cls_p = out[..., :cfg.NUM_CLASSES]
        reg_p = out[..., cfg.NUM_CLASSES:cfg.NUM_CLASSES+4]
        obj_p = out[..., -1:]
        return cls_p, reg_p, obj_p

class ImprovedModel(nn.Module):
    def __init__(self, num_classes=15):
        super().__init__()
        self.backbone_rgb = nn.Sequential(nn.Conv2d(3, 16, 3, 2, 1), nn.ReLU(), nn.Conv2d(16, 32, 3, 2, 1))
        self.backbone_th = nn.Sequential(nn.Conv2d(1, 16, 3, 2, 1), nn.ReLU(), nn.Conv2d(16, 32, 3, 2, 1))
        self.gate = nn.Sequential(nn.Conv2d(64, 2, 1), nn.Sigmoid())
        self.head = nn.Conv2d(32, num_classes + 5, 1)

    def forward(self, rgb, th):
        f_rgb = self.backbone_rgb(rgb)
        f_th = self.backbone_th(th)
        cat = torch.cat([f_rgb, f_th], dim=1)
        w = self.gate(cat)
        fused = f_rgb * w[:, 0:1] + f_th * w[:, 1:2]
        out = self.head(fused)
        B, C, H, W = out.shape
        out = out.reshape(B, -1, H*W).permute(0, 2, 1)
        cls_p = out[..., :cfg.NUM_CLASSES]
        reg_p = out[..., cfg.NUM_CLASSES:cfg.NUM_CLASSES+4]
        obj_p = out[..., -1:]
        return cls_p, reg_p, obj_p

