def plot_architecture():
    fig, ax = plt.subplots(figsize=(12, 8))
    ax.axis('off')
    ax.set_xlim(0, 10)
    ax.set_ylim(0, 10)

    # Draw blocks
    def draw_box(x, y, w, h, text, color='lightblue'):
        rect = mpatches.FancyBboxPatch((x, y), w, h, boxstyle="round,pad=0.1",
                                       facecolor=color, edgecolor='black')
        ax.add_patch(rect)
        ax.text(x+w/2, y+h/2, text, ha='center', va='center', fontsize=8)

    # Inputs
    draw_box(0.5, 8, 2, 1, 'RGB Input', 'lightcoral')
    draw_box(7.5, 8, 2, 1, 'Thermal Input', 'wheat')
    # Backbones
    draw_box(0.5, 6, 2, 1, 'RepViT Backbone\n(RGB)', 'lightgreen')
    draw_box(7.5, 6, 2, 1, 'RepViT Backbone\n(Thermal)', 'lightgreen')
    # Multi-scale
    for i, (y, label) in enumerate(zip([4.7, 3.7, 2.7, 1.7], ['C3','C4','C5','C6'])):
        draw_box(1, y, 2, 0.5, f'{label} RGB', 'palegreen')
        draw_box(7, y, 2, 0.5, f'{label} TH', 'palegreen')
    # CSTF + SAMG
    draw_box(3.5, 3, 3, 1.5, 'Cross-Modal\nTransformer Fusion\n+ Spatial Gating', 'violet')
    # FPN
    draw_box(3.5, 1.2, 3, 1, 'BiFPN-lite', 'orange')
    # Heads
    draw_box(3.5, 0, 3, 0.8, 'Decoupled Heads\n(P3-P6)', 'pink')

    ax.set_title('Improved ACAF-Net Architecture', fontweight='bold')
    plt.tight_layout()
    plt.show()

